{
  "name": "cdp-for-live",
  "version": "0.2.0",
  "description": "CDP audio processing tools as Ableton Live Extensions",
  "license": "ISC",
  "author": "Dori",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "start": "tsx build.ts && extensions-cli run",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run build && npm test && tsx scripts/deploy.ts",
    "package": "tsc --noEmit && tsx build.ts --production && extensions-cli package . -o cdp-for-live.ablx",
    "live:log": "tsx scripts/live-log.ts"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./extensions-sdk-1.0.0-beta.1/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.2.3",
    "esbuild": "0.28.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./extensions-sdk-1.0.0-beta.1/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  }
}
